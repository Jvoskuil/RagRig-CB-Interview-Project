  "evaluation_segment_map": {
    "segment_mapping_version": "1.0",
    "segments": [
      {
        "segment_id": "seg_001",
        "speaker": "Participant",
        "segment_type": "care_goal",
        "raw_interview_anchor": "To sort out the new finding properly and get her home with a plan that actually made sense given everything else going on with her.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Explicit care objective; no hidden bias occurrence."
      },
      {
        "segment_id": "seg_002",
        "speaker": "Participant",
        "segment_type": "evidence_interpretation",
        "raw_interview_anchor": "The admission ECG showed persistent atrial fibrillation... we didn't actually know if this was a mechanical trip or something with a cardiac or orthostatic component.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Balances clinical evidence and unresolved fall etiology without bias."
      },
      {
        "segment_id": "seg_003",
        "speaker": "Participant",
        "segment_type": "action_rationale",
        "raw_interview_anchor": "Given that gap, I asked for a fall-risk assessment and held off committing to a start date until we had more to go on.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Deferral is tied to incomplete diagnostic information and uncertainty."
      },
      {
        "segment_id": "seg_004",
        "speaker": "Participant",
        "segment_type": "evidence_verification",
        "raw_interview_anchor": "I didn't have the other patient's details memorized, so I asked the resident to pull what was available before I answered her.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Verifies a salient comparator rather than relying on an anecdote."
      },
      {
        "segment_id": "seg_005",
        "speaker": "Participant",
        "segment_type": "evidence_weighting",
        "raw_interview_anchor": "The CHA2DS2-VASc and HAS-BLED numbers hadn't moved... I asked for one more renal function check before finalizing a dose.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Seeks current dose-relevant renal information despite treatment-favoring scores."
      },
      {
        "segment_id": "seg_006",
        "speaker": "Participant",
        "segment_type": "discharge_decision",
        "raw_interview_anchor": "The renal result still hadn't come back. I finalized the discharge without starting treatment and arranged outpatient follow-up.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Pending renal data is the stated determinant; the bruise is irrelevant."
      },
      {
        "segment_id": "seg_007",
        "speaker": "Participant",
        "segment_type": "decision_interpretation",
        "raw_interview_anchor": "The lightheadedness before the fall... starting anticoagulation without understanding it felt premature.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Explains hesitation through unresolved fall etiology."
      },
      {
        "segment_id": "seg_008",
        "speaker": "Participant",
        "segment_type": "alternatives_and_choice",
        "raw_interview_anchor": "Start the DOAC right away... defer until the lightheadedness was evaluated... mainly because the history felt incomplete rather than because I thought waiting was inherently safer.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Considers alternatives and rejects an inaction-based rationale."
      },
      {
        "segment_id": "seg_009",
        "speaker": "Participant",
        "segment_type": "communication_choice",
        "raw_interview_anchor": "Give the daughter an accurate answer instead of a reassuring guess... I had the resident check before we talked further.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Chooses verification before communicating a comparison."
      },
      {
        "segment_id": "seg_010",
        "speaker": "Participant",
        "segment_type": "tradeoff_rationale",
        "raw_interview_anchor": "It pushed the conversation back a day... answering her with an unverified comparison seemed worse than the delay.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Weighs communication delay against unsupported information."
      },
      {
        "segment_id": "seg_011",
        "speaker": "Participant",
        "segment_type": "dose_rationale",
        "raw_interview_anchor": "Her creatinine on admission was borderline, and dosing a DOAC on stale numbers didn't sit right with me.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Uses current renal data while acknowledging a reasonable alternative."
      },
      {
        "segment_id": "seg_012",
        "speaker": "Participant",
        "segment_type": "experience_based_reasoning",
        "raw_interview_anchor": "Dosing decisions where the renal number is borderline... here we had very little runway before discharge.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Connects experience and time without asserting a biased rule."
      },
      {
        "segment_id": "seg_013",
        "speaker": "Participant",
        "segment_type": "evidence_relevance",
        "raw_interview_anchor": "It didn't really change anything clinically since she wasn't on the drug yet. The bigger factor was still the pending renal result.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Rejects the unrelated bruise as relevant evidence."
      },
      {
        "segment_id": "seg_014",
        "speaker": "Participant",
        "segment_type": "counterfactual_reasoning",
        "raw_interview_anchor": "A clear low score would have resolved a lot of the hesitation at the first decision point.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Narrow counterfactual about clearer fall-risk information."
      },
      {
        "segment_id": "seg_015",
        "speaker": "Participant",
        "segment_type": "counterfactual_reasoning",
        "raw_interview_anchor": "The family conversation would have gone faster, but I don't think it would have changed the actual treatment timing much.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Separates communication effects from the independent renal question."
      },
      {
        "segment_id": "seg_016",
        "speaker": "Participant",
        "segment_type": "retrospective_guidance",
        "raw_interview_anchor": "Chase down unexplained symptoms... and don't assume a story about another patient applies to yours without checking the details.",
        "eligible_reasoning_segment": true,
        "ground_truth_bias_present": false,
        "ground_truth_instance_ids": [],
        "ground_truth_rationale": "Endorses evidence checking and avoiding unsupported comparisons."
      }
    ]
  },
